{
  "expo": {
    "name": "market2pot",
    "slug": "market2pot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "market2pot",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.market2pot.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F1E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.market2pot.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F7F1E6",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Market2pot needs access to your photos so you can set a profile picture and add photos to your produce listings.",
          "cameraPermission": "Market2pot needs access to your camera so you can take a profile picture and photograph your produce."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Market2pot uses your location to fill in your delivery address and show you farmers near you."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "owner": "9inelabs",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "36c7205c-1bd8-4c86-9026-7da2d7480647"
      }
    }
  }
}
